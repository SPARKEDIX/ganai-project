# BrandRadar — environment template
# Copy to .env.local aur values bharo. Ye file kabhi commit mat karo.

# Groq LLM key (server-side only — kabhi browser mein nahi jaata)
GROQ_API_KEY=

# (Optional) Voice provider — vach_ type key agar ho toh (TTS/STT).
# Default: browser-native Web Speech API (free, koi key nahi chahiye).
VACH_API_KEY=
VACH_BASE_URL=
